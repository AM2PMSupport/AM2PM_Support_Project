# Copy to .env.local (git-ignored) or run `vercel env pull .env.local`.
# Never commit real values.

# Base URL used to build QStash callback URLs and webhook URLs shown to admins.
APP_URL=http://localhost:3000
# Public HTTPS address given to CallerDesk / lead sources for webhooks (never localhost)
PUBLIC_URL=https://am2pmsupportproject.vercel.app

# Neon Postgres (Vercel Marketplace injects these). Region: AWS ap-south-1 (Mumbai).
# DATABASE_URL           pooled (PgBouncer) — used by the app at runtime
# DATABASE_URL_UNPOOLED  direct — used by `npm run db:migrate`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: Neon read replica URLs (pooled), comma-separated. Empty = reads use the primary.
# Reads route to the replica with the LEAST active connections (lib/db/client.ts).
DATABASE_REPLICA_URLS=

# Upstash QStash: publish jobs + verify /api/jobs/* callbacks.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis: call locks, caches, rate limits.
# (Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN instead — both names work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32-byte key, base64. Encrypts provider credentials and backup data keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=

# Protects /api/cron/* (Vercel sends it as a Bearer token).
CRON_SECRET=

# Auth.js (wired in T1.11).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
